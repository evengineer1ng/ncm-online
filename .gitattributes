# Line endings are a deployment concern here, not a cosmetic one. NCM source is
# authored on Windows and executed on Linux (Lightsail), and a CR-insensitive
# diff was once needed to compare local files against deployed ones. Normalise
# in the repo to LF so the two sides are byte-comparable.
* text=auto eol=lf

# Windows-only launchers genuinely want CRLF.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Never touch these.
*.png      binary
*.jpg      binary
*.xbm      binary
*.zip      binary
*.archive  binary
*.dll      binary
*.exe      binary
