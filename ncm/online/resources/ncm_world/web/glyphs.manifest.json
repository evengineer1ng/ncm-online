{
  "version": 1,
  "grid": 24,
  "fallback": "currentColor",
  "palette": ["--glyph-accent", "--accent", "--ok", "--warn", "--red", "--dim"],
  "glyphs": [
    { "id": "sanctioned", "bindsTo": ["guide.tier.sanctioned"] },
    { "id": "street", "bindsTo": ["guide.tier.street"] },
    { "id": "timer", "bindsTo": ["race.mode.time_trial"] },
    { "id": "practice", "bindsTo": ["venue.practice", "race.mode.practice"] },
    { "id": "circuit", "bindsTo": ["guide.route.closed_loop", "race.progress"] },
    { "id": "point_to_point", "bindsTo": ["guide.route.point_to_point"] },
    { "id": "signup", "bindsTo": ["guide.interest", "event.state.signup"] },
    { "id": "registered", "bindsTo": ["event.state.registered"] },
    { "id": "upcoming", "bindsTo": ["event.state.upcoming"] },
    { "id": "live", "bindsTo": ["race.state.live", "race.banner.go"] },
    { "id": "completed", "bindsTo": ["race.results", "event.state.completed"] },
    { "id": "cancelled", "bindsTo": ["event.state.cancelled"] },
    { "id": "full", "bindsTo": ["event.state.full"] },
    { "id": "private", "bindsTo": ["event.state.private"] },
    { "id": "history", "bindsTo": ["venue.history"] },
    { "id": "incident", "bindsTo": ["race.incident", "race.banner.bad"] },
    { "id": "penalty", "bindsTo": ["race.penalty"] },
    { "id": "disconnect", "bindsTo": ["race.disconnect"] },
    { "id": "formation", "bindsTo": ["race.start.rolling", "race.grid"] },
    { "id": "finish", "bindsTo": ["race.finish", "race.graph.finish"] },
    { "id": "message", "bindsTo": ["panel.messages"] },
    { "id": "enter", "bindsTo": ["venue.enter_race"] },
    { "id": "withdraw", "bindsTo": ["venue.withdraw", "venue.leave_list", "guide.withdraw"] },
    { "id": "crew", "bindsTo": null },
    { "id": "voice", "bindsTo": null },
    { "id": "friends", "bindsTo": null },
    { "id": "watch", "bindsTo": null },
    { "id": "photo_mode", "bindsTo": null },
    { "id": "replay", "bindsTo": null }
  ]
}
