<?xml version="1.0" encoding="utf-8"?>
<!-- NCM (L336): the Archer Hella as a Kitten Space Agency craft: the SAME Machine that left Night City through Deep.
     Parts are the Machine's own (core engineering.installation, L333): Fusion Drive FD-1, Propellant Tank PT-400,
     Attitude Control Set AC-6. Generated by NCM; the mesh and textures are made locally from the player's own game files
     by tools/ksa-hella-body.py and are never committed.
     Frame: +X forward (the FD-1 pushes along it), +Y right, +Z down; the body is centred on its bounding box. -->
<Assets>
  <MeshAtlas Path="Meshes/NcmHella_MeshAtlas.glb" />
  <PbrMaterial Id="NcmHella_Material">
    <Diffuse Path="Textures/NcmHella_Diffuse.png" Category="Vessel" />
    <Normal Path="Textures/NcmHella_Normal.png" Category="Vessel" />
    <AoRoughMetal Path="Textures/NcmHella_PBR.png" Category="Vessel" />
  </PbrMaterial>

  <Part Id="NcmHella_Part" CrashTolerance="2e5">
    <SubPart Id="NcmHella_Body1" InstanceOf="NcmHella_Subpart_Body" />
  </Part>
  <SubPart Id="NcmHella_Subpart_Body">
    <PartModel Id="NcmHella_Subpart_Body_Model">
      <Mesh Id="NcmHella_Body" />
      <Material Id="NcmHella_Material" />
    </PartModel>
  </SubPart>

  <PartGameData Id="NcmHella_Part" DisplayName="Archer Hella (NCM Machine)">
    <Control />
    <!-- the FD-1's controller lives on the part and names its subpart, as KSA's own drives do (a controller inside the
         subpart, as the MMU's thrusters have, left the main engine dead: 0 N on the first bench, 2026-10-07) -->
    <RocketEngineController Id="FD-1">
      <RocketReference Id="FD1Engine" SubPartId="NcmHella_Body1" />
    </RocketEngineController>
    <Battery>
      <MaximumCapacity J="200000" />
    </Battery>
    <Collider Id="NcmHellaCollider">
      <Box Id="NcmHellaBox">
        <LocationAsmb X="0" Y="0" Z="0" />
        <Collider2Asmb X="0" Y="0" Z="0" />
        <LengthX M="5.81" />
        <LengthY M="2.07" />
        <LengthZ M="1.48" />
      </Box>
    </Collider>
  </PartGameData>

  <SubPartGameData Id="NcmHella_Subpart_Body">
    <!-- dry, as NCM weighs it: car 1800 + IA-10 40 (its ground hop has no use here: carried, not fitted) + AC-6 30 + FD-1 150
         + PT-400 70 = 2090 kg; inertia of a solid 5.81 x 2.37 x 1.48 m box -->
    <CustomMass>
      <LocationAsmb X="0" Y="0" Z="0.15" />
      <Mass Kg="2090" />
      <MassSpecificInertia Ixx="0.650608" Iyy="2.995542" Izz="3.281083" />
    </CustomMass>

    <!-- Propellant Tank PT-400: 400 kg in 0.4 m^3, behind the rear seats on the centreline. KSA has no "fusion pellet":
         the FD-1 is expressed with KSA's directed-exhaust core, so the tank holds its reaction mass (water) and the
         trace of antihydrogen that core accounts its jet power to (2.1 g in 400 kg). An expression loss, said. -->
    <Tank Id="PT500">
      <SphericalTank>
        <LocationAsmb X="-1.6" Y="0" Z="0.15" />
        <Material Id="Aluminum.2014(s)" />
        <OuterRadius M="0.461078" />
        <WallThickness Mm="4" />
        <RoleAffinity>Engine</RoleAffinity>
      </SphericalTank>
    </Tank>
    <!-- ...and its trap: KSA holds antimatter only in a magnetic trap, and a trap holds nothing else -->
    <Tank Id="PT500Trap">
      <SphericalTank>
        <LocationAsmb X="-1.6" Y="0" Z="-0.4" />
        <Material Id="Aluminum.2014(s)" />
        <OuterRadius M="0.05" />
        <WallThickness Mm="2" />
        <RoleAffinity>Engine</RoleAffinity>
      </SphericalTank>
      <MagneticTrap Value="true" />
    </Tank>
    <!-- the Machine's own fuel, which the AC-6 burns in Night City (hypergolic here: KSA's attitude thrusters burn it) -->
    <Tank Id="AC6Tank">
      <SphericalTank>
        <LocationAsmb X="0" Y="0" Z="0.15" />
        <Material Id="Aluminum.2014(s)" />
        <OuterRadius M="0.21" />
        <WallThickness Mm="3" />
        <RoleAffinity>Thruster</RoleAffinity>
      </SphericalTank>
    </Tank>

    <!-- Fusion Drive FD-1: 30 kN at Isp 100000 s (exhaust 981 km/s = 0.3271 % of c; jet power 14.71 GW). Its thrust line runs
         through the centre of mass on the centreline, so it needs none of Night City's +-3 deg gimbal trim. -->
    <Rocket Id="FD1Engine">
      <Core Id="FD1Core" />
      <Nozzle Id="FD1Nozzle" />
    </Rocket>
    <AntimatterRamCore Id="FD1Core">
      <FeedsFrom Container="PT500" />
      <FeedsFrom Container="PT500Trap" />
      <JetPower GW="14.709975" />
      <AnnihilationEfficiency Value="0.5" />
      <CarriedExhaustFractionOfLight Value="0.003271146" />
      <Antimatter Id="AntiH2(l)" />
      <ReactionMass Id="H2O(l)" />
      <MinimumThrottle Value="0.01" />
    </AntimatterRamCore>
    <MagneticNozzle Id="FD1Nozzle">
      <FxExitDiameter M="0.5" />
      <ExhaustLocation X="-2.905" Y="0" Z="0.15" />
      <ExhaustDirection X="-1" Y="0" Z="0" />
      <SoundEvent Action="On" SoundId="DefaultEngineSoundBehavior" />
    </MagneticNozzle>

    <!-- Attitude Control Set AC-6: four opposed-pair quads (pitch / roll / yaw), ~1 m arms: the MMU's layout scaled to the car -->
    <RocketThrusterController Id="AC6_PitchDownRollLeftYawRight">
      <ControlMap CSV="PitchDown,RollLeft,YawRight" />
      <RocketReference Id="AC6_PitchDownRollLeftYawRightRocket" />
    </RocketThrusterController>
    <Rocket Id="AC6_PitchDownRollLeftYawRightRocket">
      <Core Id="AC6_PitchDownRollLeftYawRightCore" />
      <Nozzle Id="AC6_PitchDownRollLeftYawRight1" />
      <Nozzle Id="AC6_PitchDownRollLeftYawRight2" />
    </Rocket>
    <Combustor Id="AC6_PitchDownRollLeftYawRightCore">
      <FeedsFrom Container="AC6Tank" />
      <Plumbing>Service</Plumbing>
      <Reaction Id="MMH_NTO">
        <MixtureRatio>1.6</MixtureRatio>
      </Reaction>
      <MaxPressure Bar="21" />
      <ThermalEfficiency Value="0.75" />
      <MinimumPulseTime Seconds="0" />
    </Combustor>
    <DeLavalNozzle Id="AC6_PitchDownRollLeftYawRight1">
      <ExitDiameter M="0.116" />
      <AreaRatio Value="50" />
      <FlowEfficiency Value="0.72" />
      <ExpansionEfficiency Value="0.5" />
      <ExhaustLocation X="0" Y="0.4" Z="1.28384" />
      <ExhaustDirection X="0.707106" Y="0" Z="0.707106" />
      <ReactionPlume Default="true">
        <VolumetricExhaust Id="MmuRcsVac" />
      </ReactionPlume>
      <ExhaustLight Value="false" />
      <SoundEvent Action="On" SoundId="DefaultRcsThruster" />
    </DeLavalNozzle>
    <DeLavalNozzle Id="AC6_PitchDownRollLeftYawRight2">
      <ExitDiameter M="0.116" />
      <AreaRatio Value="50" />
      <FlowEfficiency Value="0.72" />
      <ExpansionEfficiency Value="0.5" />
      <ExhaustLocation X="0" Y="-0.4" Z="-0.71616" />
      <ExhaustDirection X="-0.707106" Y="0" Z="-0.707106" />
      <ReactionPlume Default="true">
